# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Recommended: qwen2.5:3b (3GB RAM, fast) or llama3.2:3b (good alternative)
# For higher quality but slower: llama3:8b (6GB RAM)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.7

# Database
LIEBCHEN_DB_PATH=data/liebchen.db

# Agent
LIEBCHEN_MAX_ITERATIONS=4

# Voice
VOICE_ENERGY_THRESHOLD=300
VOICE_PAUSE_THRESHOLD=0.8
